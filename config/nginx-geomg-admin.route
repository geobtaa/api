location = /admin {
    return 308 /admin/$is_args$args;
}
location ^~ /admin/ {
    resolver 127.0.0.11 valid=10s ipv6=off;
    set $geomg_service geomg-admin-alpha:8000;
    rewrite ^/admin(/.*)$ $1 break;
    proxy_pass http://$geomg_service;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $ssr_forwarded_proto;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_cache off;
}
