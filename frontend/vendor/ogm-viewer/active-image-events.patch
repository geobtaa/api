+import { describe, expect, it, vi } from 'vitest';
+import { observeImageSelection, observePreviewSelection, preferManifest, previewLabel } from './preview-events';
+
+const image = { previewId: 'image-1', resourceId: 'record', url: 'https://example.org/manifest', renderer: 'image' as const };
+const map = { previewId: 'map-1', resourceId: 'record', url: 'https://example.org/map', renderer: 'map' as const };
+const host = () => new EventTarget() as HTMLElement;
+
+describe('image selection events', () => {
+  it('reports initial and later opened sources, clearing during transitions and failures', () => {
+    const handlers = new Map<string, () => void>();
+    let page = 0;
+    const viewer = {
+      currentPage: () => page,
+      goToPage: vi.fn(),
+      tileSources: [{ tileSource: 'https://example.org/a/info.json' }, { tileSource: 'https://example.org/b/info.json' }],
+      addHandler: (name: string, handler: () => void) => handlers.set(name, handler),
+      removeHandler: (name: string) => handlers.delete(name),
+    };
+    const element = host();
+    const emit = vi.fn();
+    const stop = observeImageSelection(element, viewer, () => image, emit);
+    handlers.get('open')!();
+    expect(emit).toHaveBeenLastCalledWith({
+      previewId: image.previewId,
+      resourceId: image.resourceId,
+      resourceUrl: image.url,
+      renderer: 'image',
+      sequence: viewer.tileSources.map((source, index) => ({ url: source.tileSource, index, occurrence: 0 })),
+      pageIndex: 0,
+      image: { url: viewer.tileSources[0].tileSource, index: 0, count: 2, occurrence: 0 },
+    });
+    page = 1;
+    handlers.get('page')!();
+    expect(emit.mock.lastCall?.[0].image).toBeNull();
+    handlers.get('open')!();
+    expect(emit.mock.lastCall?.[0].image).toEqual({ url: viewer.tileSources[1].tileSource, index: 1, count: 2, occurrence: 0 });
+    viewer.tileSources[1] = viewer.tileSources[0];
+    handlers.get('open')!();
+    expect(emit.mock.lastCall?.[0].image.occurrence).toBe(1);
+    page = 0;
+    handlers.get('open')!();
+    expect(emit.mock.lastCall?.[0].image.occurrence).toBe(0);
+    handlers.get('open-failed')!();
+    expect(emit.mock.lastCall?.[0].image).toBeNull();
+    element.dispatchEvent(new Event('imageLoading'));
+    expect(emit.mock.lastCall?.[0].image).toBeNull();
+    stop();
+    const count = emit.mock.calls.length;
+    element.dispatchEvent(new Event('imageLoading'));
+    expect(emit).toHaveBeenCalledTimes(count);
+    expect(handlers.size).toBe(0);
+  });
+
+  it('does not invent a source URL for an unknown tile source', () => {
+    const handlers = new Map<string, () => void>();
+    const emit = vi.fn();
+    const stop = observeImageSelection(
+      host(),
+      {
+        currentPage: () => 0,
+        goToPage: vi.fn(),
+        tileSources: [{ type: 'custom' }],
+        addHandler: (name, handler) => {
+          handlers.set(name, handler);
+        },
+        removeHandler: name => {
+          handlers.delete(name);
+        },
+      },
+      () => image,
+      emit,
+    );
+    handlers.get('open')!();
+    expect(emit.mock.lastCall?.[0].image).toBeNull();
+    stop();
+  });
+});
+
+describe('active preview events', () => {
+  it('follows tabs, ignores nested tab names, and resets when the record changes', () => {
+    const element = host();
+    let previews = [image, map];
+    const emit = vi.fn();
+    const observer = observePreviewSelection(element, () => previews, emit);
+    observer.update();
+    expect(emit.mock.lastCall?.[0].previewId).toBe('image-1');
+    element.dispatchEvent(new CustomEvent('wa-tab-show', { detail: { name: 'map-1' } }));
+    expect(emit.mock.lastCall?.[0].renderer).toBe('map');
+    emit.mockClear();
+    element.dispatchEvent(new Event('previewsLoaded'));
+    expect(emit).toHaveBeenCalledTimes(1);
+    expect(emit.mock.lastCall?.[0].renderer).toBe('map');
+    observer.update();
+    element.dispatchEvent(new CustomEvent('wa-tab-show', { detail: { name: 'metadata' } }));
+    expect(emit).toHaveBeenCalledTimes(1);
+    previews = [{ ...image, resourceId: 'next', previewId: 'image-2' }];
+    observer.update();
+    expect(emit.mock.lastCall?.[0].resourceId).toBe('next');
+    previews = [];
+    observer.update();
+    expect(emit.mock.lastCall?.[0]).toBeNull();
+    observer.disconnect();
+    previews = [image, map];
+    element.dispatchEvent(new CustomEvent('wa-tab-show', { detail: { name: 'map-1' } }));
+    expect(emit.mock.lastCall?.[0]).toBeNull();
+  });
+});
+
+it('routes navigation through shadow hosts to the addressed image and removes the listener', () => {
+  const root = Object.assign(new EventTarget(), { nodeName: 'OGM-VIEWER' });
+  const element = Object.assign(new EventTarget(), { parentNode: { host: root } }) as unknown as HTMLElement;
+  const goToPage = vi.fn();
+  const viewer = {
+    currentPage: () => 0,
+    goToPage,
+    tileSources: [{ tileSource: 'https://example.org/a/info.json' }, { tileSource: 'https://example.org/a/info.json' }],
+    addHandler: vi.fn(),
+    removeHandler: vi.fn(),
+  };
+  const stop = observeImageSelection(element, viewer, () => image, vi.fn());
+  const request = { previewId: image.previewId, resourceId: image.resourceId, resourceUrl: image.url, renderer: 'image', index: 1, url: viewer.tileSources[1].tileSource };
+  const send = (detail: unknown) => root.dispatchEvent(new CustomEvent('imageNavigationRequest', { detail }));
+  for (const invalid of [
+    null,
+    { ...request, index: -1 },
+    { ...request, index: 2 },
+    { ...request, index: 0.5 },
+    { ...request, previewId: 'hidden-preview' },
+    { ...request, resourceId: 'old-record' },
+    { ...request, resourceUrl: 'other-manifest' },
+    { ...request, url: 'different-source' },
+  ])
+    send(invalid);
+  expect(goToPage).not.toHaveBeenCalled();
+  send(request);
+  expect(goToPage).toHaveBeenCalledExactlyOnceWith(1);
+  stop();
+  send(request);
+  expect(goToPage).toHaveBeenCalledTimes(1);
+});
+
+describe('IIIF preview defaults and recovery', () => {
+  const manifest = { ...image, previewId: 'manifest', kind: 'iiif-manifest', url: 'https://example.org/manifest' };
+  const single = { ...image, previewId: 'single', kind: 'iiif-image', url: 'https://example.org/image' };
+  function setup(previews: Array<Omit<typeof single, 'renderer'> & { renderer: 'image' | 'map' }> = [manifest, single]) {
+    const element = host();
+    const tabs = previews.map(preview => ({
+      disabled: false,
+      hidden: false,
+      style: { display: '' },
+      getAttribute: (key: string) => (key === 'panel' ? preview.previewId : null),
+      setAttribute: vi.fn(),
+      removeAttribute: vi.fn(),
+    }));
+    let active = '';
+    const changed = vi.fn();
+    const group = {
+      toggleAttribute: vi.fn(),
+      get active() {
+        return active;
+      },
+      set active(value: string) {
+        active = value;
+        changed(value);
+        element.dispatchEvent(new CustomEvent('wa-tab-show', { detail: { name: value } }));
+      },
+    };
+    Object.defineProperty(element, 'shadowRoot', { value: { querySelector: () => group, querySelectorAll: () => tabs } });
+    const emit = vi.fn();
+    const observer = observePreviewSelection(element, () => previews, emit);
+    observer.update();
+    const fail = (preview: typeof single) => {
+      const event = new CustomEvent('previewError');
+      Object.defineProperty(event, 'composedPath', { value: () => [{ tagName: 'OGM-IMAGE', previewer: preview }] });
+      element.dispatchEvent(event);
+    };
+    const open = (preview: typeof single) =>
+      element.dispatchEvent(
+        new CustomEvent('imageChange', {
+          detail: {
+            previewId: preview.previewId,
+            resourceId: preview.resourceId,
+            resourceUrl: preview.url,
+            image: { url: 'https://example.org/scan' },
+          },
+        }),
+      );
+    return { element, tabs, changed, observer, emit, fail, open };
+  }
+
+  it('prefers the complete manifest without mutating source order and uses readable labels', () => {
+    const original = [single, map, manifest];
+    expect(preferManifest(original)).toEqual([manifest, single, map]);
+    expect(original).toEqual([single, map, manifest]);
+    expect(previewLabel({ ...manifest, label: () => 'IIIF Manifest' })).toBe('Images');
+    expect(previewLabel({ ...single, label: () => 'IIIF Image' })).toBe('Single image');
+    expect(previewLabel({ ...map, label: () => 'Location' })).toBe('Location');
+  });
+
+  it('omits location previews only when requested by a containing viewer', () => {
+    const location = { ...map, kind: 'location' };
+    const layer = { ...map, kind: 'wms' };
+    const viewer = { hasAttribute: (name: string) => name === 'omit-location' };
+    const element = { parentNode: { host: viewer } } as unknown as HTMLElement;
+    expect(preferManifest([location, layer, manifest], element)).toEqual([manifest, layer]);
+    expect(preferManifest([location], element)).toEqual([]);
+    expect(preferManifest([location])).toEqual([location]);
+  });
+
+  it('renders a single canvas from the first frame, then reveals fallback navigation on failure', () => {
+    const element = host();
+    const observer = observePreviewSelection(element, () => [manifest, single], vi.fn());
+    // No update, loaded event, or image request is needed for the first render.
+    expect(observer.tabAttributes(single)).toEqual({ hidden: true, style: { display: 'none' } });
+    expect(observer.singlePreview()).toBe(true);
+    observer.disconnect();
+    const state = setup();
+    state.fail(manifest);
+    expect(state.observer.tabAttributes(single).hidden).toBe(false);
+    expect(state.observer.singlePreview()).toBe(false);
+    state.element.dispatchEvent(new Event('previewsLoading'));
+    expect(state.observer.singlePreview()).toBe(true);
+    const standalone = observePreviewSelection(host(), () => [single], vi.fn());
+    expect(standalone.tabAttributes(single).hidden).toBe(false);
+    expect(standalone.singlePreview()).toBe(true);
+    standalone.disconnect();
+    const multiple = observePreviewSelection(host(), () => [manifest, map], vi.fn());
+    expect(multiple.singlePreview()).toBe(false);
+    multiple.disconnect();
+  });
+
+  it.each([true, false])('keeps the fallback hidden during manifest loading and after success (loaded first: %s)', loadedFirst => {
+    const { element, open, fail, tabs, changed } = setup();
+    if (loadedFirst) open(manifest);
+    fail(single);
+    if (!loadedFirst) {
+      expect(tabs[1].hidden).toBe(true);
+      open(manifest);
+    }
+    expect(changed).not.toHaveBeenCalled();
+    expect(tabs[1].disabled).toBe(true);
+    expect(tabs[1].hidden).toBe(true);
+    expect(tabs[1].style.display).toBe('none');
+    expect(tabs[1].setAttribute).toHaveBeenCalledWith('title', 'Preview unavailable');
+    open(single);
+    expect(tabs[1].disabled).toBe(false);
+    expect(tabs[1].hidden).toBe(true);
+    expect(tabs[1].style.display).toBe('none');
+    element.dispatchEvent(new Event('previewsLoading'));
+    fail(single);
+    open(manifest);
+    expect(tabs[1].hidden).toBe(true);
+    element.dispatchEvent(new Event('previewsLoading'));
+    expect(tabs[1].hidden).toBe(true);
+    expect(tabs[1].style.display).toBe('none');
+  });
+
+  it('replaces a healthy single image with a loaded manifest and hides the redundant tab', () => {
+    const { element, open, tabs, changed } = setup();
+    open(single);
+    expect(tabs[1].hidden).toBe(true);
+    element.dispatchEvent(new CustomEvent('wa-tab-show', { detail: { name: single.previewId } }));
+    open(manifest);
+    expect(changed).toHaveBeenCalledExactlyOnceWith('manifest');
+    expect(tabs[1].hidden).toBe(true);
+    expect(tabs[1].disabled).toBe(false);
+    expect(tabs[0].hidden).toBe(false);
+  });
+
+  it.each([true, false])('recovers an initial failure only after the other image opens (loaded first: %s)', loadedFirst => {
+    const { open, fail, changed, tabs, emit } = setup();
+    if (loadedFirst) open(single);
+    fail(manifest);
+    if (!loadedFirst) {
+      expect(changed).not.toHaveBeenCalled();
+      open(single);
+    }
+    expect(changed).toHaveBeenCalledExactlyOnceWith('single');
+    expect(emit.mock.lastCall?.[0].previewId).toBe('single');
+    expect(tabs[0].disabled).toBe(true);
+    expect(tabs[1].hidden).toBe(false);
+  });
+
+  it('does not abandon an opened book on a later page error or switch when both sources fail', () => {
+    const book = setup();
+    book.open(manifest);
+    book.open(single);
+    book.fail(manifest);
+    expect(book.changed).not.toHaveBeenCalled();
+    const unavailable = setup();
+    unavailable.fail(manifest);
+    unavailable.fail(single);
+    expect(unavailable.changed).not.toHaveBeenCalled();
+    expect(unavailable.tabs[0].disabled).toBe(false);
+    expect(unavailable.tabs.every(tab => !tab.hidden)).toBe(true);
+  });
+
+  it('ignores previous records, respects a chosen non-image preview, and cleans up listeners', () => {
+    const { element, observer, open, fail, changed } = setup([manifest, single, { ...single, ...map }]);
+    fail({ ...manifest, resourceId: 'old' });
+    open(single);
+    expect(changed).not.toHaveBeenCalled();
+    element.dispatchEvent(new CustomEvent('wa-tab-show', { detail: { name: map.previewId } }));
+    fail(manifest);
+    expect(changed).not.toHaveBeenCalled();
+    observer.disconnect();
+    element.dispatchEvent(new CustomEvent('wa-tab-show', { detail: { name: manifest.previewId } }));
+    fail(manifest);
+    expect(changed).not.toHaveBeenCalled();
+  });
+});
