@@ -0,0 +1,282 @@
+/** Public selection events shared by the image and preview components. */
+export interface PreviewSelection {
+  previewId: string;
+  resourceId: string;
+  resourceUrl: string;
+  renderer: 'image' | 'map';
+}
+
+export interface ImageSequenceEntry {
+  url: string;
+  index: number;
+  occurrence: number;
+}
+
+export interface ImageNavigation extends PreviewSelection {
+  index: number;
+  url: string;
+}
+
+export interface ImageSelection extends PreviewSelection {
+  sequence: ImageSequenceEntry[];
+  pageIndex: number;
+  image: { url: string; index: number; count: number; occurrence: number } | null;
+}
+
+interface Preview {
+  kind?: string;
+  previewId: string;
+  resourceId: string;
+  url: string;
+  renderer: 'image' | 'map';
+}
+
+/** A manifest represents the complete object, so offer it before a standalone scan. */
+export function preferManifest<T extends Preview>(previews: T[], host?: HTMLElement): T[] {
+  // Consumers with a separate location map can omit the metadata-only preview.
+  let ancestor: Node | undefined = host;
+  while (ancestor) {
+    if ((ancestor as HTMLElement).hasAttribute?.('omit-location')) {
+      previews = previews.filter(preview => preview.kind !== 'location');
+      break;
+    }
+    ancestor = ancestor.parentNode ?? (ancestor as ShadowRoot).host;
+  }
+  const primary = previews.filter(preview => preview.kind === 'iiif-manifest' && preview.renderer === 'image');
+  return [...primary, ...previews.filter(preview => !primary.includes(preview))];
+}
+
+export function previewLabel(preview: Preview & { label(): string }): string {
+  if (preview.renderer === 'image' && preview.kind === 'iiif-manifest') return 'Images';
+  if (preview.renderer === 'image' && preview.kind === 'iiif-image') return 'Single image';
+  return preview.label();
+}
+
+interface ImageViewer {
+  currentPage(): number;
+  goToPage(index: number): unknown;
+  tileSources?: unknown[];
+  addHandler(name: string, handler: () => void): void;
+  removeHandler(name: string, handler: () => void): void;
+}
+
+function selection(preview: Preview): PreviewSelection {
+  return {
+    previewId: preview.previewId,
+    resourceId: preview.resourceId,
+    resourceUrl: preview.url,
+    renderer: preview.renderer,
+  };
+}
+
+/** Report the source actually opened, and clear it while a page changes or fails. */
+export function observeImageSelection(host: HTMLElement, viewer: ImageViewer, getPreview: () => Preview | undefined, emit: (detail: ImageSelection) => void): () => void {
+  const sourceUrl = (source: unknown) => {
+    const url = typeof source === 'string' ? source : (source as { tileSource?: unknown })?.tileSource;
+    return typeof url === 'string' ? url : undefined;
+  };
+  const snapshot = () => {
+    const occurrences = new Map<string, number>();
+    const sequence: ImageSequenceEntry[] = [];
+    (viewer.tileSources ?? []).forEach((source, index) => {
+      const url = sourceUrl(source);
+      if (!url) return;
+      const occurrence = occurrences.get(url) ?? 0;
+      occurrences.set(url, occurrence + 1);
+      sequence.push({ url, index, occurrence });
+    });
+    return { sequence, pageIndex: viewer.currentPage() };
+  };
+  const clear = () => {
+    const preview = getPreview();
+    if (preview) emit({ ...selection(preview), ...snapshot(), image: null });
+  };
+  const opened = () => {
+    const preview = getPreview();
+    if (!preview) return;
+    const state = snapshot();
+    const image = state.sequence.find(image => image.index === state.pageIndex);
+    emit({
+      ...selection(preview),
+      ...state,
+      image: image ? { ...image, count: viewer.tileSources?.length ?? 0 } : null,
+    });
+  };
+  // Requests are addressed to the public viewer host; each image validates its identity.
+  // Standalone ogm-image elements receive the same request on their own host.
+  let commandTarget = host;
+  let ancestor: Node | undefined = host;
+  while (ancestor) {
+    if (ancestor.nodeName === 'OGM-VIEWER') {
+      commandTarget = ancestor as HTMLElement;
+      break;
+    }
+    ancestor = ancestor.parentNode ?? (ancestor as ShadowRoot).host;
+  }
+  const navigate = (event: Event) => {
+    const request = (event as CustomEvent<ImageNavigation>).detail;
+    const preview = getPreview();
+    if (
+      !request ||
+      !preview ||
+      request.previewId !== preview.previewId ||
+      request.resourceId !== preview.resourceId ||
+      request.resourceUrl !== preview.url ||
+      request.renderer !== 'image' ||
+      !Number.isInteger(request.index) ||
+      request.index < 0 ||
+      request.index >= (viewer.tileSources?.length ?? 0) ||
+      request.url !== sourceUrl(viewer.tileSources?.[request.index])
+    )
+      return;
+    viewer.goToPage(request.index);
+  };
+  commandTarget.addEventListener('imageNavigationRequest', navigate);
+  viewer.addHandler('open', opened);
+  for (const event of ['page', 'open-failed', 'close']) viewer.addHandler(event, clear);
+  host.addEventListener('imageLoading', clear);
+  return () => {
+    viewer.removeHandler('open', opened);
+    for (const event of ['page', 'open-failed', 'close']) viewer.removeHandler(event, clear);
+    host.removeEventListener('imageLoading', clear);
+    commandTarget.removeEventListener('imageNavigationRequest', navigate);
+  };
+}
+
+/** Publish the initial preview and tab switches, including transitions to non-image previews. */
+export function observePreviewSelection(host: HTMLElement, getPreviews: () => Preview[], emit: (detail: PreviewSelection | null) => void) {
+  let signature: string | undefined;
+  let activeId: string | undefined;
+  let last: string | undefined;
+  const opened = new Set<string>();
+  const failed = new Set<string>();
+  const isIiifImage = (preview: Preview) => preview.renderer === 'image' && (preview.kind === 'iiif-manifest' || preview.kind === 'iiif-image');
+  const hiddenPreview = (preview: Preview) => {
+    const previews = getPreviews();
+    const active = activeId ?? previews[0]?.previewId;
+    return (
+      preview.kind === 'iiif-image' &&
+      preview.previewId !== active &&
+      previews.some(candidate => candidate.kind === 'iiif-manifest' && candidate.renderer === 'image' && !failed.has(candidate.previewId))
+    );
+  };
+  // Used by render itself, before the custom tabs upgrade or any image opens.
+  const tabAttributes = (preview: Preview) => ({ hidden: hiddenPreview(preview), style: { display: hiddenPreview(preview) ? 'none' : '' } });
+  const singlePreview = () => getPreviews().filter(preview => !hiddenPreview(preview)).length <= 1;
+  const refreshAvailability = () => {
+    const previews = getPreviews();
+    host.shadowRoot?.querySelector('wa-tab-group')?.toggleAttribute('data-single-preview', singlePreview());
+    host.shadowRoot?.querySelectorAll('wa-tab').forEach(tab => {
+      const id = tab.getAttribute('panel') ?? '';
+      const unavailable = failed.has(id);
+      const preview = previews.find(preview => preview.previewId === id);
+      const hide = !!preview && hiddenPreview(preview);
+      (tab as HTMLElement).hidden = hide;
+      // The custom tab's display rule can override the browser's hidden style.
+      (tab as HTMLElement).style.display = hide ? 'none' : '';
+      // Keep the active error readable when every alternative has failed.
+      (tab as HTMLElement & { disabled: boolean }).disabled = unavailable && tab.getAttribute('panel') !== activeId;
+      if (unavailable) tab.setAttribute('title', 'Preview unavailable');
+      else tab.removeAttribute('title');
+    });
+  };
+  const recover = () => {
+    const previews = getPreviews();
+    const active = previews.find(preview => preview.previewId === activeId);
+    const manifest = previews.find(preview => preview.kind === 'iiif-manifest' && preview.renderer === 'image' && opened.has(preview.previewId) && !failed.has(preview.previewId));
+    if (active?.kind === 'iiif-image' && manifest) {
+      const group = host.shadowRoot?.querySelector('wa-tab-group') as (HTMLElement & { active: string }) | null;
+      if (group) group.active = manifest.previewId;
+      return;
+    }
+    if (!activeId || !failed.has(activeId) || opened.has(activeId)) return;
+    const fallback = getPreviews().find(preview => isIiifImage(preview) && opened.has(preview.previewId) && !failed.has(preview.previewId));
+    if (!fallback) return;
+    const group = host.shadowRoot?.querySelector('wa-tab-group') as (HTMLElement & { active: string }) | null;
+    if (group) group.active = fallback.previewId;
+  };
+  const publish = (preview?: Preview) => {
+    const detail = preview ? selection(preview) : null;
+    const serialized = JSON.stringify(detail);
+    if (serialized !== last) {
+      last = serialized;
+      emit(detail);
+    }
+  };
+  const update = () => {
+    const previews = getPreviews();
+    const next = JSON.stringify(previews.map(selection));
+    if (next !== signature) {
+      signature = next;
+      activeId = previews[0]?.previewId;
+      opened.clear();
+      failed.clear();
+    }
+    publish(previews.find(preview => preview.previewId === activeId));
+    refreshAvailability();
+  };
+  const shown = (event: Event) => {
+    const id = (event as CustomEvent<{ name?: string }>).detail?.name;
+    const preview = getPreviews().find(preview => preview.previewId === id);
+    if (!preview) return;
+    // An initial tab event can precede the first componentDidRender callback.
+    signature = JSON.stringify(getPreviews().map(selection));
+    activeId = id;
+    publish(preview);
+    refreshAvailability();
+    recover();
+  };
+  const loaded = () => {
+    // Reloading the same record can preserve preview IDs and the active tab.
+    // Consumers cleared their selection on previewsLoading, so republish it.
+    last = undefined;
+    update();
+  };
+  const imageOpened = (event: Event) => {
+    const detail = (event as CustomEvent<ImageSelection>).detail;
+    if (!detail?.image) return;
+    const preview = getPreviews().find(preview => preview.previewId === detail.previewId && preview.resourceId === detail.resourceId && preview.url === detail.resourceUrl);
+    if (!preview || !isIiifImage(preview)) return;
+    update();
+    opened.add(preview.previewId);
+    failed.delete(preview.previewId);
+    refreshAvailability();
+    recover();
+  };
+  const previewFailed = (event: Event) => {
+    // Capture before ogm-preview stops propagation. The public previewer property
+    // identifies the failed image even when a manifest also has a map preview.
+    const origin = event.composedPath().find(node => (node as HTMLElement).tagName === 'OGM-IMAGE') as (HTMLElement & { previewer?: Preview }) | undefined;
+    const source = origin?.previewer;
+    const preview = source && getPreviews().find(preview => preview.previewId === source.previewId && preview.resourceId === source.resourceId && preview.url === source.url);
+    if (!preview || !isIiifImage(preview)) return;
+    update();
+    // Never abandon a book because a later sheet cannot load.
+    if (opened.has(preview.previewId)) return;
+    failed.add(preview.previewId);
+    refreshAvailability();
+    recover();
+  };
+  const loading = () => {
+    opened.clear();
+    failed.clear();
+    refreshAvailability();
+  };
+  host.addEventListener('previewsLoading', loading);
+  host.addEventListener('imageChange', imageOpened);
+  host.addEventListener('previewError', previewFailed, true);
+  host.addEventListener('wa-tab-show', shown);
+  host.addEventListener('previewsLoaded', loaded);
+  return {
+    tabAttributes,
+    singlePreview,
+    update,
+    disconnect: () => {
+      host.removeEventListener('previewsLoading', loading);
+      host.removeEventListener('imageChange', imageOpened);
+      host.removeEventListener('previewError', previewFailed, true);
+      host.removeEventListener('wa-tab-show', shown);
+      host.removeEventListener('previewsLoaded', loaded);
+    },
+  };
+}
