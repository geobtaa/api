  "scripts": {
    "dev": "NODE_OPTIONS='--require ./appsignal.cjs --require source-map-support/register' react-router dev",
    "build": "react-router build",
    "start": "NODE_OPTIONS='--require ./appsignal.cjs --require source-map-support/register' react-router-serve ./build/server/index.js",
    "update-imports": "node scripts/update-react-router-imports.js",
    "lint": "eslint 'src/**/*.{ts,tsx}'",
    "lint:fix": "eslint 'src/**/*.{ts,tsx}' --fix",
    "format": "prettier --write 'src/**/*.{ts,tsx,css,md,json}'",
    "format:check": "prettier --check 'src/**/*.{ts,tsx,css,md,json}'",
    "preview": "vite preview",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist",
    "test": "vitest",
    "test:allmaps": "vitest run src/__tests__/hooks/useAllmapsAvailability.test.tsx src/__tests__/integration/Allmaps.integration.test.tsx src/__tests__/utils/allmaps.test.ts src/__tests__/components/ResourceView.test.tsx",
    "test:watch": "vitest --watch",
    "test:ui": "vitest --ui",
    "coverage": "vitest --coverage",
    "test:coverage": "vitest --coverage",
    "test:coverage:ui": "vitest --coverage --ui",
    "test:a11y": "node scripts/run-a11y-tests.cjs",
    "test:a11y:pa11y": "pa11y-ci",
    "test:a11y:pa11y:item": "pa11y-ci http://localhost:3000/resources/p16022coll583:2574",
    "test:a11y:pa11y:ci": "npm run build && start-server-and-test 'vite preview --port 4173' http://localhost:4173 pa11y-ci",
    "generate-pwa-icons": "pwa-assets-generator",
    "test:viewer:browser": "playwright test -c playwright.viewer.config.ts",
    "test:viewer:browser:dev": "playwright test -c playwright.viewer.config.ts --project=development",
    "test:viewer:browser:build": "playwright test -c playwright.viewer.config.ts --project=production"
  },
