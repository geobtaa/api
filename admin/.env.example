APP_ENV=development
APP_NAME=GEOMG Admin
APP_VERSION=0.1.0
AUTH_MODE=development
API_PORT=8000
DATABASE_URL=postgresql+asyncpg://postgres:postgres@paradedb:5432/geomg
CORS_ORIGINS=http://localhost:3000
DEV_AUTH_ACTOR_ID=local-developer
DEV_AUTH_DISPLAY_NAME=Local Developer
DEV_AUTH_EMAIL=developer@localhost
DEV_AUTH_PERMISSIONS=admin.session:read,sources:read,sources:use,sources:create,sources:update,source-activity:read,source-activity:create,sets:read,sets:create,sets:update,set-activity:read,resources:read,resources:create,resources:associate,resources:import,resources:bulk-update,resources:update,tasks:read,tasks:create,tasks:update,tasks:complete,work:configure,work:report
FRONTEND_PORT=3000
POSTGRES_DB=geomg
POSTGRES_PORT=2345
POSTGRES_PASSWORD=postgres
POSTGRES_USER=postgres
# Optional external storage: create postgresql/ and node_modules/ first.
# COMPOSE_FILE=compose.yaml:compose.storage.yaml
# PROJECT_DATA_DIR=/absolute/path/to/project-data
