  "@type": "prof:Profile",
  "title": "BTAA resource UI hints profile",
  "description": "Resource meta.ui contains optional presentation hints such as citations, thumbnails, downloads and viewers. These are ordinary JSON, outside the meta.jsonld graph. Their presence does not assert RDF types or predicates.",
